{
  "compilerOptions": {
    "target": "esnext",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "esModuleInterop": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "baseUrl": "./",
    "paths": {
      "components/*": [ "src/components/*" ],
      "dapps/*": [ "src/dapps/*" ],
      "layouts/*": [ "src/layouts/*" ],
      "lib/*": [ "src/lib/*" ],
      "providers/*": [ "src/providers/*" ],
      "public/*": [ "public/*" ],
      "react": [ "./node_modules/@types/react" ],
      "src/*": [ "src/*" ],
      "themes/*": [ "src/themes/*" ]
    }
  },
  "include": [
    "next-env.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "src/**/*.local/*",
    "src/*.local/*"
  ]
}
