{
  "name": "@gamedao/haiku",
  "description": "a monorepo for gamedao dapps",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "setup": "yarn && wsrun -s -c install",
    "reset": "rm -rf node_modules apps/**/node_modules packages/**/node_modules apps/**/.next packages/**/.next",
    "sb": "wsrun -p @gamedao/components -c storybook",
    "dev": "yarn dev:web",
    "dev:web": "wsrun -p @gamedao/web -c dev",
    "dev:app": "wsrun -p @gamedao/app -c dev",
    "dev:astar": "wsrun -p @gamedao/astar -c dev",
    "dev:battlepass": "wsrun -p @gamedao/battlepass -c dev",
    "dev:avatar": "wsrun -p @gamedao/avatar -c dev",
    "dev:graph": "wsrun -p @gamedao/graph-api -c dev",
    "build:all": "wsrun -e -c -s -x -m build",
    "build:init": "wsrun -s -c install",
    "generate": "yarn workspace @gamedao/graph generate",
    "build:astar": "yarn build:init && yarn generate && yarn workspace @gamedao/astar build",
    "build:avatar": "yarn build:init && yarn workspace @gamedao/avatar build",
    "build:web": "yarn build:init && yarn workspace @gamedao/web build",
    "build:app": "yarn build:init && yarn workspace @gamedao/app build",
    "build:admin": "yarn build:init && yarn workspace @gamedao/admin build",
    "build:battlepass": "yarn build:init && yarn workspace @gamedao/battlepass build",
    "build:prod:app": "yarn npm-run-all -s build:app",
    "build:graph-api": "yarn workspace @gamedao/graph-api docker:build",
    "test": "wsrun -e -c -s --exclude-missing test",
    "format": "prettier --parser babel-ts --write --check '{apps,packages}/**/*.{ts,tsx,graphql}'",
    "format:graphql": "prettier --parser babel-ts --check '{apps,packages}/**/*.graphql'",
    "format:verify": "prettier --parser babel-ts --check '{apps,packages}/**/*.{ts,tsx}'",
    "format:staged": "pretty-quick --staged --pattern '*.{js,jsx,ts,tsx,graphql}'",
    "lint": "yarn lint:app",
    "lint:app": "yarn eslint 'apps/**/src'",
    "release": "yarn build && yarn changeset publish",
    "release:stage": "git checkout dev && git pull && git checkout stage && git pull && git merge dev && git push",
    "commit": "git-cz"
  },
  "publishConfig": {
    "access": "public"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "husky": {
    "hooks": {
      "commit-msg": "commitlint -E HUSKY_GIT_PARAMS",
      "pre-commit": "yarn lint-staged"
    }
  },
  "lint-staged": {
    "*": "echo yarn format:staged"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.23.2",
    "@commitlint/cli": "19.5.0",
    "@commitlint/config-conventional": "19.5.0",
    "@commitlint/cz-commitlint": "19.5.0",
    "@picgo/bump-version": "^1.0.3",
    "@typescript-eslint/utils": "8.14.0",
    "commitizen": "^4.3.0",
    "conventional-changelog": "6.0.0",
    "cz-conventional-changelog": "^3.3.0",
    "cz-customizable": "^7.0.0",
    "eslint": "9.15.0",
    "eslint-plugin-graphql": "^4.0.0",
    "eslint-plugin-json": "^4.0.1",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-storybook": "0.11.0",
    "husky": "9.1.6",
    "lint-staged": "15.2.10",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.0.3",
    "prettier-eslint": "^16.3.0",
    "pretty-quick": "4.0.0",
    "rimraf": "6.0.1",
    "wsrun": "^5.2.1"
  },
  "resolutions": {
    "@polkadot/api": "^14.3.1",
    "@polkadot/keyring": "^13.2.3",
    "@polkadot/networks": "^13.2.3",
    "@polkadot/util": "^13.2.3",
    "@polkadot/util-crypto": "^13.2.3",
    "@polkadot/wasm-crypto": "^7.3.1",
    "@polkadot/wasm-util": "^7.3.1",
    "@polkadot/x-randomvalues": "^13.2.3",
    "next": "^13.2.4",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.2.2"
  }
}
