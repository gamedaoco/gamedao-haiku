{
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution":"nodenext",
    "target": "esnext",
    "jsx": "react-jsx",
    "lib": ["dom", "dom.iterable", "esnext"],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "strict": true,
    "baseUrl": ".",
    "references": [
      { "path": "./packages/core" },
      { "path": "./packages/ui" },
      { "path": "./packages/graph" }
    ]
  },
  "include": ["packages/**/*", "apps/**/*"],
  "exclude": ["node_modules"]
}
